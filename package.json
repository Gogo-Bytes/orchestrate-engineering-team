{
  "name": "orchestrate-engineering-team",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.0.0 <23" },
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "check": "pnpm check:agent-profiles",
    "check:agent-profiles": "node scripts/agent-profiles/check.mjs",
    "test": "node --test scripts/agent-profiles/checker.test.mjs packages/cli/test/*.test.js scripts/evals/*.test.mjs scripts/release/check-copied-package.test.mjs scripts/release/skill-cli-install.test.mjs scripts/release/codex-plugin-lifecycle.test.mjs",
    "check:package": "node scripts/release/check-copied-package.mjs && node scripts/packages/package-smoke.mjs",
    "smoke:skill-install": "node scripts/release/skill-cli-install.mjs",
    "eval": "node scripts/evals/run.mjs",
    "eval:list": "node scripts/evals/run.mjs --list",
    "verify": "pnpm check && pnpm test && pnpm check:package"
  },
  "devDependencies": { "yaml": "2.9.0" }
}
